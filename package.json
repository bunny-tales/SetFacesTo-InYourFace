{
  "name": "set-faces-to-in-your-face",
  "displayName": "Set faces to In Your Face",
  "description": "Set faces to In Your Face, shows your personalized 'Uncanny Faces' that correlate to the number of errors in your code!",
  "version": "0.0.1",
  "publisher": "BunnyTalessss",
  "homepage": "https://github.com/bunny-tales",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bunny-tales/SetFacesTo-InYourFace"
  },
  "engines": {
    "vscode": "^1.61.0"
  },
  "categories": [
    "Visualization"
  ],
  "icon": "assets/icon.png",
  "galleryBanner": {
    "color": "#191919",
    "theme": "dark"
  },
  "keywords": [
    "in your face",
    "visualization",
    "incredible",
    "ouch",
    "face",
    "errors",
    "error lens",
    "error count",
    "Set faces to In Your Face"
  ],
  "__metadata": {
    "publisherDisplayName": "BunnyTalessss"
  },
  "activationEvents": [
    "onCommand:set-faces-to-in-your-face.openview.focus",
    "onView:set-faces-to-in-your-face.openview"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "custom-activitybar",
          "title": "Set faces to In Your Face",
          "icon": "assets/logo_bito.svg"
        }
      ]
    },
    "views": {
      "custom-activitybar": [
        {
          "type": "webview",
          "id": "set-faces-to-in-your-face.openview",
          "name": "Set faces to In Your Face",
          "contextualTitle": "Set faces to In Your Face"
        }
      ]
    },
    "commands": [
      {
        "command": "set-faces-to-in-your-face.openview.focus",
        "category": "Set faces to In Your Face",
        "title": "Open Sidebar",
        "icon": "$(clear-all)"
      }
    ],
    "configuration": {
      "title": "Extension settings Set Your Face - In Your Face",
      "properties": {
        "set-faces-to-in-your-face.customErrorImage0": {
          "type": "string",
          "default": "",
          "description": "Custom image for 0 errors."
        },
        "set-faces-to-in-your-face.customErrorImage1": {
          "type": "string",
          "default": "",
          "description": "Custom image for 1-4 errors."
        },
        "set-faces-to-in-your-face.customErrorImage2": {
          "type": "string",
          "default": "",
          "description": "Custom image for 5-9 errors."
        },
        "set-faces-to-in-your-face.customErrorImage3": {
          "type": "string",
          "default": "",
          "description": "Custom image for 10+ errors."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/glob": "^7.1.4",
    "@types/mocha": "^9.0.0",
    "@types/node": "^14.18.21",
    "@types/vscode": "^1.61.0",
    "@typescript-eslint/eslint-plugin": "^4.31.1",
    "@typescript-eslint/parser": "^4.31.1",
    "@vscode/test-electron": "^1.6.2",
    "eslint": "^7.32.0",
    "glob": "^7.1.7",
    "mocha": "^9.1.1",
    "typescript": "^4.7.3"
  }

}

